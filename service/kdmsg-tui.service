[Unit]
Description=KDMSG TUI Diagnostic Service on TTY 10
After=systemd-user-sessions.service network.target
Conflicts=getty@tty10.service
Before=getty@tty10.service

[Service]
ExecStart=/sbin/kdmsg-tui-ng
Restart=always
RestartSec=1

# TTY & Kiosk Einstellungen
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty10
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

User=root
Group=root
UtmpIdentifier=tty10
UtmpFacility=syslog

[Install]
WantedBy=multi-user.target
